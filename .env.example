# Kopyala: cp .env.example .env   (.env gitignore'da, repoya girmez)
APP_ENV=development
# 8080 başka yerel projelerle çakışabilir; geliştirmede 8090 kullanıyoruz
HTTP_ADDR=:8090

# docker-compose.yml'deki geliştirme veritabanı
POSTGRES_PASSWORD=hesapkitap_dev
DATABASE_URL=postgres://hesapkitap:hesapkitap_dev@localhost:5432/hesapkitap?sslmode=disable

# Trendyol E-Faturam — geliştirmede stage. Prod'da stage adresi reddedilir.
TRENDYOL_BASE_URL=https://stage-apigateway.trendyolefaturam.com
TRENDYOL_EMAIL=
TRENDYOL_PASSWORD=

# Firma e-Fatura mükellefi mi? false iken tüm faturalar e-Arşiv kesilir.
EINVOICE_ENABLED=false
# e-Fatura kesilirse senaryo: TEMELFATURA veya TICARIFATURA
EINVOICE_SCENARIO=TEMELFATURA

# Fatura serisi (3 karakter, örn. ABC). Boşsa portaldaki varsayılan seri kullanılır; tanımlı değilse Trendyol
# "Corporate default prefix record not found" der. Stage'de ABC portalda tanımlanmadan da çalıştı.
INVOICE_PREFIX=ABC

# Satıcı (firma) bilgileri — yalnızca taslak fatura PDF önizlemesinde yazılır (isteğe bağlı).
# Kesilen gerçek faturadaki bilgiler Trendyol'daki firma kaydından gelir.
COMPANY_NAME=
COMPANY_TAX_ID=
COMPANY_TAX_OFFICE=
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_PHONE=
COMPANY_EMAIL=

# Müşteriye fatura bağlantısını e-postayla göndermek için (isteğe bağlı; HOST ve FROM doluysa düğme görünür).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
