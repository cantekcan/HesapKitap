package views

type navItem struct {
	Label string
	Href  string
	Key   string
}

var navItems = []navItem{
	{Label: "Pano", Href: "/", Key: "dashboard"},
	{Label: "Müşteriler", Href: "/customers", Key: "customers"},
	{Label: "Ürünler", Href: "/products", Key: "products"},
	{Label: "Faturalar", Href: "/invoices", Key: "invoices"},
	{Label: "Tahsilatlar", Href: "/payments", Key: "payments"},
}

// PageData is the data every authenticated page needs.
type PageData struct {
	Title  string
	Active string
	Email  string
}

func navClass(active bool) string {
	base := "flex items-center rounded-md px-3 py-2 text-sm font-medium "
	if active {
		return base + "bg-slate-800 text-white"
	}
	return base + "text-slate-300 hover:bg-slate-800 hover:text-white"
}

templ head(title string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title } · Hesap Kitap</title>
	<link rel="stylesheet" href="/static/app.css"/>
	<script src="/static/htmx.min.js" defer></script>
	<script src="/static/alpine.min.js" defer></script>
}

templ Layout(p PageData) {
	<!DOCTYPE html>
	<html lang="tr" class="h-full bg-slate-50">
		<head>
			@head(p.Title)
		</head>
		<body class="h-full text-slate-900" x-data="{ open: false }" @keydown.escape.window="open = false">
			<div class="lg:hidden flex items-center justify-between bg-slate-900 px-4 py-3 text-white">
				<span class="text-base font-semibold">Hesap Kitap</span>
				<button type="button" class="rounded-md p-2 hover:bg-slate-800" @click="open = !open" aria-label="Menüyü aç/kapat" :aria-expanded="open">
					<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
				</button>
			</div>
			<div x-show="open" x-cloak class="fixed inset-0 z-20 bg-black/40 lg:hidden" @click="open = false"></div>
			<aside
				class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col bg-slate-900 p-4 transition-transform lg:translate-x-0"
				:class="{ '-translate-x-full': !open }"
			>
				<div class="mb-6 px-3 text-lg font-semibold text-white">Hesap Kitap</div>
				<nav class="flex-1 space-y-1" aria-label="Ana menü">
					for _, item := range navItems {
						<a href={ templ.SafeURL(item.Href) } class={ navClass(item.Key == p.Active) }>{ item.Label }</a>
					}
				</nav>
				<div class="border-t border-slate-700 pt-4">
					<div class="truncate px-3 pb-2 text-xs text-slate-400">{ p.Email }</div>
					<form method="post" action="/logout">
						<button type="submit" class="w-full rounded-md px-3 py-2 text-left text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white">Çıkış</button>
					</form>
				</div>
			</aside>
			<main class="lg:pl-64">
				<div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
					<h1 class="mb-6 text-2xl font-semibold">{ p.Title }</h1>
					{ children... }
				</div>
			</main>
		</body>
	</html>
}
