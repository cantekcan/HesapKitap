package views

import "fmt"

// Confirm describes a styled confirmation dialog that posts to Action when the user agrees.
// It replaces the browser's confirm() box for actions that must not happen by accident.
type Confirm struct {
	Action      string
	Button      string // tetikleyen düğmenin yazısı
	ButtonClass string
	Title       string
	Message     string
	Details     [][2]string // özet satırları (etiket, değer)
	Yes         string      // onay düğmesinin yazısı
	Danger      bool        // kırmızı ton
	Ack         string      // doluysa kullanıcı önce bu cümleyi işaretlemeli
}

func confirmState(c Confirm) string {
	return fmt.Sprintf("{ open: false, ack: false, busy: false, needAck: %t }", c.Ack != "")
}

func confirmIconClass(c Confirm) string {
	if c.Danger {
		return "bg-rose-100 text-rose-600"
	}
	return "bg-brand-100 text-brand-600"
}

func confirmYesClass(c Confirm) string {
	if c.Danger {
		return "btn bg-rose-600 text-white shadow-sm hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-50"
	}
	return "btn btn-primary disabled:cursor-not-allowed disabled:opacity-50"
}

templ ConfirmAction(c Confirm) {
	<div x-data={ confirmState(c) } class="inline-block" @keydown.escape.window="open = false">
		<button type="button" class={ c.ButtonClass } @click="open = true; ack = false">{ c.Button }</button>
		<div x-show="open" x-cloak class="fixed inset-0 z-50 flex items-end justify-center p-4 sm:items-center" role="dialog" aria-modal="true">
			<div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" x-show="open" x-transition.opacity @click="open = false"></div>
			<div
				class="relative w-full max-w-md overflow-hidden rounded-3xl bg-white p-6 shadow-2xl ring-1 ring-slate-900/5"
				x-show="open"
				x-transition:enter="transition ease-out duration-200"
				x-transition:enter-start="translate-y-4 scale-95 opacity-0"
				x-transition:enter-end="translate-y-0 scale-100 opacity-100"
			>
				<div class={ "mx-auto flex h-14 w-14 items-center justify-center rounded-full " + confirmIconClass(c) }>
					if c.Danger {
						@Icon("alert")
					} else {
						@Icon("check")
					}
				</div>
				<h3 class="mt-4 text-center text-lg font-semibold text-slate-900">{ c.Title }</h3>
				<p class="mt-2 text-center text-sm leading-relaxed text-slate-600">{ c.Message }</p>
				if len(c.Details) > 0 {
					<dl class="mt-4 space-y-1.5 rounded-2xl bg-slate-50 p-4 text-sm ring-1 ring-inset ring-slate-200/70">
						for _, d := range c.Details {
							<div class="flex items-baseline justify-between gap-4">
								<dt class="text-slate-500">{ d[0] }</dt>
								<dd class="text-right font-semibold text-slate-900">{ d[1] }</dd>
							</div>
						}
					</dl>
				}
				<form method="post" action={ templ.SafeURL(c.Action) } @submit="busy = true" class="mt-5">
					if c.Ack != "" {
						<label class="mb-4 flex cursor-pointer items-start gap-2.5 rounded-xl bg-amber-50 p-3 text-sm text-amber-900 ring-1 ring-inset ring-amber-200">
							<input type="checkbox" x-model="ack" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"/>
							<span>{ c.Ack }</span>
						</label>
					}
					<div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
						<button type="button" class="btn btn-secondary" @click="open = false">Vazgeç</button>
						<button type="submit" class={ confirmYesClass(c) } :disabled="busy || (needAck && !ack)">{ c.Yes }</button>
					</div>
				</form>
			</div>
		</div>
	</div>
}
