package views

import (
	"fmt"

	"hesapkitap/internal/money"
	"hesapkitap/internal/product"
)

// ProductList is the data of the product list page and its HTMX fragment.
type ProductList struct {
	Items     []product.Product
	Query     string
	Status    string
	Page      int
	PageCount int
	Total     int
}

// ProductForm is the data of the new/edit product page.
type ProductForm struct {
	Product   product.Product
	IsNew     bool
	Errors    product.FieldErrors
	UnitPrice string // kullanıcının yazdığı metin
	Saved     bool
}

func productPageHref(l ProductList, page int) string {
	return fmt.Sprintf("/products?q=%s&status=%s&page=%d", templURLEscape(l.Query), l.Status, page)
}

templ ProductsPage(p PageData, l ProductList) {
	@Layout(p) {
		<div class="mb-4 flex flex-wrap items-center gap-3">
			<form
				class="flex flex-1 flex-wrap items-center gap-2"
				hx-get="/products"
				hx-target="#product-list"
				hx-trigger="input changed delay:300ms from:#q, change from:#status, submit"
				hx-push-url="true"
			>
				<input id="q" name="q" type="search" value={ l.Query } placeholder="Ürün adı veya kodu ara…" class="input !mt-0 sm:!w-80"/>
				<select id="status" name="status" class="input !mt-0 sm:!w-48">
					<option value="" selected?={ l.Status == "" }>Tümü</option>
					<option value="active" selected?={ l.Status == "active" }>Aktif</option>
					<option value="passive" selected?={ l.Status == "passive" }>Pasif</option>
				</select>
			</form>
			if p.Can("product.write") {
				<a href="/products/new" class={ btnPrimary }>+ Yeni ürün</a>
			}
		</div>
		@ProductListFragment(l)
	}
}

templ ProductListFragment(l ProductList) {
	<div id="product-list">
		if len(l.Items) == 0 {
			<div class="card border-dashed p-10 text-center text-slate-500">
				if l.Query != "" || l.Status != "" {
					Aramanıza uyan ürün yok.
				} else {
					Henüz ürün yok. “Yeni ürün” ile ilkini ekleyin.
				}
			</div>
		} else {
			<div class="table-card">
				<table class="data-table">
					<thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
						<tr>
							<th class="px-4 py-3">Ürün / Hizmet</th>
							<th class="hidden px-4 py-3 sm:table-cell">Kod</th>
							<th class="px-4 py-3">Birim</th>
							<th class="px-4 py-3 text-right">Birim fiyat (KDV hariç)</th>
							<th class="px-4 py-3 text-right">KDV</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, pr := range l.Items {
							<tr class="hover:bg-slate-50">
								<td class="px-4 py-3">
									<a href={ templ.SafeURL("/products/" + pr.ID.String()) } class="font-medium text-slate-900 hover:underline">{ pr.Name }</a>
									if !pr.Active {
										<span class="ml-2 rounded bg-slate-200 px-1.5 py-0.5 text-xs text-slate-600">Pasif</span>
									}
								</td>
								<td class="hidden px-4 py-3 font-mono text-slate-600 sm:table-cell">{ pr.Code }</td>
								<td class="px-4 py-3 text-slate-600">{ product.UnitLabel(pr.Unit) }</td>
								<td class="px-4 py-3 text-right tabular-nums">{ money.FormatTL(pr.UnitPrice) }</td>
								<td class="px-4 py-3 text-right tabular-nums">%{ fmt.Sprint(pr.TaxPercent) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="mt-3 flex items-center justify-between text-sm text-slate-600">
				<span>{ fmt.Sprint(l.Total) } ürün</span>
				if l.PageCount > 1 {
					<div class="flex items-center gap-2">
						if l.Page > 1 {
							<a href={ templ.SafeURL(productPageHref(l, l.Page-1)) } hx-get={ productPageHref(l, l.Page-1) } hx-target="#product-list" hx-push-url="true" class={ btnSecondary }>← Önceki</a>
						}
						<span>{ fmt.Sprint(l.Page) } / { fmt.Sprint(l.PageCount) }</span>
						if l.Page < l.PageCount {
							<a href={ templ.SafeURL(productPageHref(l, l.Page+1)) } hx-get={ productPageHref(l, l.Page+1) } hx-target="#product-list" hx-push-url="true" class={ btnSecondary }>Sonraki →</a>
						}
					</div>
				}
			</div>
		}
	</div>
}

func productFormAction(f ProductForm) string {
	if f.IsNew {
		return "/products"
	}
	return "/products/" + f.Product.ID.String()
}

templ ProductFormPage(p PageData, f ProductForm) {
	@Layout(p) {
		<form method="post" action={ templ.SafeURL(productFormAction(f)) } class="max-w-2xl space-y-4 card p-5">
			if f.Saved {
				<div class="rounded-xl bg-emerald-50 px-3 py-2 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-200">Kaydedildi.</div>
			}
			if len(f.Errors) > 0 {
				<div class="rounded-xl bg-rose-50 px-3 py-2 text-sm text-rose-800 ring-1 ring-inset ring-rose-200">Lütfen işaretli alanları düzeltin.</div>
			}
			<div class="grid gap-4 sm:grid-cols-2">
				@formField("Ürün / hizmet adı", "name", f.Product.Name, f.Errors["name"], "Faturada bu ad görünür")
				@formField("Kod (isteğe bağlı)", "code", f.Product.Code, f.Errors["code"], "Stok kodu; boş bırakılabilir")
				<div>
					<label for="unit" class="block text-sm font-medium text-slate-700">Birim</label>
					<select id="unit" name="unit" class={ inputClass }>
						for _, u := range product.Units {
							<option value={ u.Code } selected?={ f.Product.Unit == u.Code }>{ u.Label }</option>
						}
					</select>
				</div>
				@formField("Birim fiyat (₺, KDV hariç)", "unit_price", f.UnitPrice, f.Errors["unit_price"], "Örn. 1.250,00")
				<div>
					<label for="tax_percent" class="block text-sm font-medium text-slate-700">KDV oranı</label>
					<select id="tax_percent" name="tax_percent" class={ inputClass }>
						for _, v := range product.TaxPercents {
							<option value={ fmt.Sprint(v) } selected?={ f.Product.TaxPercent == v }>%{ fmt.Sprint(v) }</option>
						}
					</select>
				</div>
			</div>
			<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" value="1" checked?={ f.Product.Active }/> Aktif</label>
			<div class="flex gap-3 pt-2">
				if p.Can("product.write") {
					<button type="submit" class={ btnPrimary }>Kaydet</button>
				}
				<a href="/products" class={ btnSecondary }>Listeye dön</a>
			</div>
		</form>
	}
}
