package views

import (
	"fmt"

	"hesapkitap/internal/ledger"
	"hesapkitap/internal/money"
)

// ReminderRow is one customer on the reminders page.
type ReminderRow struct {
	CustomerID string
	Reminder   ledger.Reminder
	Text       string
	Email      string
	WhatsApp   string // uluslararası rakamlar, boşsa numara yok/geçersiz
	Phone      string
}

func mailtoHref(row ReminderRow) string {
	return "mailto:" + row.Email + "?subject=" + templURLEscape("Ödeme hatırlatması") + "&body=" + templURLEscape(row.Text)
}

func waHref(row ReminderRow) string {
	return "https://wa.me/" + row.WhatsApp + "?text=" + templURLEscape(row.Text)
}

templ RemindersPage(p PageData, rows []ReminderRow) {
	@Layout(p) {
		<p class="mb-5 max-w-3xl text-sm text-slate-500">Vadesi geçmiş ve { fmt.Sprint(ledger.UpcomingDays) } gün içinde vadesi gelecek faturalar. Mesaj hazır; kendi WhatsApp'ınızdan veya e-posta programınızdan göndermeniz için açılır — sistem kendiliğinden mesaj göndermez.</p>
		if len(rows) == 0 {
			<div class="card p-10 text-center text-slate-500">
				<span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
					@Icon("check")
				</span>
				Hatırlatılacak borç yok. Tüm ödemeler yolunda.
			</div>
		}
		<div class="space-y-4">
			for _, row := range rows {
				<div class="card p-5" x-data="{ copied: false, open: false }">
					<div class="flex flex-wrap items-start justify-between gap-3">
						<div>
							<a href={ templ.SafeURL("/customers/" + row.CustomerID) } class="text-base font-semibold hover:underline">{ row.Reminder.CustomerName }</a>
							<div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
								if row.Reminder.OverdueTotal > 0 {
									<span class="text-rose-600">Vadesi geçmiş: <span class="font-semibold tabular-nums">{ money.FormatTL(row.Reminder.OverdueTotal) }</span></span>
								}
								if row.Reminder.UpcomingSum > 0 {
									<span class="text-amber-700">Yaklaşan: <span class="font-semibold tabular-nums">{ money.FormatTL(row.Reminder.UpcomingSum) }</span></span>
								}
							</div>
							<div class="mt-1 text-xs text-slate-500">{ row.Phone } { row.Email }</div>
						</div>
						<div class="flex flex-wrap gap-2">
							if row.WhatsApp != "" {
								<a href={ templ.SafeURL(waHref(row)) } target="_blank" rel="noopener" class="btn btn-primary btn-sm">WhatsApp</a>
							}
							if row.Email != "" {
								<a href={ templ.SafeURL(mailtoHref(row)) } class="btn btn-secondary btn-sm">E-posta</a>
							}
							<button type="button" class="btn btn-secondary btn-sm" @click={ "navigator.clipboard.writeText(" + jsonString(row.Text) + "); copied = true" }>
								<span x-show="!copied">Metni kopyala</span>
								<span x-show="copied" x-cloak>Kopyalandı</span>
							</button>
							<button type="button" class="btn btn-secondary btn-sm" @click="open = !open">Önizle</button>
						</div>
					</div>
					<pre x-show="open" x-cloak class="mt-3 whitespace-pre-wrap rounded-xl bg-slate-50 p-3 font-sans text-sm text-slate-700">{ row.Text }</pre>
				</div>
			}
		</div>
	}
}
