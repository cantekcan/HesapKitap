package views

templ Placeholder(p PageData, phase string) {
	@Layout(p) {
		<div class="card border-dashed p-10 text-center text-slate-500">
			Bu bölüm { phase } kapsamında eklenecek.
		</div>
	}
}

templ ErrorPage(p PageData, msg string) {
	@Layout(p) {
		<div class="rounded-lg border border-red-200 bg-red-50 p-8 text-center text-red-800">{ msg }</div>
	}
}

templ NotFound(p PageData) {
	@Layout(p) {
		<div class="rounded-lg border border-slate-200 bg-white p-8 text-center text-slate-600">
			Aradığınız sayfa bulunamadı.
		</div>
	}
}
