package views

templ Dashboard(p PageData) {
	@Layout(p) {
		<p class="mb-6 text-slate-600">Hoş geldiniz. Rakamlar Faz 7'de (Pano ve raporlar) eklenecek.</p>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			@statCard("Toplam alacak")
			@statCard("Vadesi geçmiş alacak")
			@statCard("Bu ay kesilen fatura")
		</div>
	}
}

templ statCard(label string) {
	<div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
		<div class="text-sm text-slate-500">{ label }</div>
		<div class="mt-1 text-2xl font-semibold text-slate-400">—</div>
	</div>
}

templ Placeholder(p PageData, phase string) {
	@Layout(p) {
		<div class="rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
			Bu bölüm { phase } kapsamında eklenecek.
		</div>
	}
}

templ NotFound(p PageData) {
	@Layout(p) {
		<div class="rounded-lg border border-slate-200 bg-white p-8 text-center text-slate-600">
			Aradığınız sayfa bulunamadı.
		</div>
	}
}
