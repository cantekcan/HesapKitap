package views

// IncomingPage is the place of the invoices that suppliers sent us (alış faturaları).
// The provider's incoming-invoice endpoints are not in docs/trendyol-efaturam-api.md yet, so nothing is invented here:
// the page says what is missing instead of showing made-up numbers.
templ IncomingPage(p PageData) {
	@Layout(p) {
		<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			@plannedTile("Onay bekleyen ticari")
			@plannedTile("Okunmamış e-Fatura")
			@plannedTile("Onay bekleyen temel")
			@plannedTile("Tüm gelen e-Faturalar")
		</div>
		<div class="card mt-6 p-6">
			<div class="flex items-start gap-4">
				<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
					@Icon("alert")
				</span>
				<div>
					<h2 class="card-title">Gelen faturalar henüz bağlanmadı</h2>
					<p class="mt-1 text-sm leading-relaxed text-slate-600">
						Trendyol E-Faturam'ın gelen e-Fatura uçları (listeleme, kabul/ret, PDF) elimizdeki API belgesinde yer almıyor;
						uç noktaları tahmin ederek yazmak canlı sistemde yanlış sonuç verir. Belgenin ilgili bölümünü
						<code class="rounded bg-slate-100 px-1 text-xs">docs/trendyol-efaturam-api.md</code> dosyasına eklediğimizde bu sayfa,
						yukarıdaki dört kutucuğa göre filtrelenen bir tabloya dönüşecek ve tedarikçi borç takibine bağlanacak.
					</p>
					<ul class="mt-3 list-inside list-disc text-sm text-slate-600">
						<li>Gelen fatura listesi ve filtreleri (onay bekleyen ticari, okunmamış, temel)</li>
						<li>Ticari faturada kabul / ret</li>
						<li>Gelen faturanın PDF'i ve tedarikçi bakiyesi</li>
					</ul>
				</div>
			</div>
		</div>
	}
}

templ plannedTile(label string) {
	<div class="rounded-2xl bg-slate-50 p-4 text-slate-500 ring-1 ring-inset ring-slate-200">
		<div class="text-[11px] font-semibold uppercase leading-tight tracking-wide">{ label }</div>
		<div class="mt-4 flex items-end justify-between">
			<span class="opacity-50">
				@Icon("arrow-down")
			</span>
			<span class="text-4xl font-semibold leading-none">—</span>
		</div>
		<div class="mt-2 text-right text-[11px]">API belgesi bekleniyor</div>
	</div>
}
