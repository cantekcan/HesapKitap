package views

templ Login(errMsg, email string) {
	<!DOCTYPE html>
	<html lang="tr" class="h-full">
		<head>
			@head("Giriş")
		</head>
		<body class="flex min-h-full flex-col items-center justify-center bg-gradient-to-br from-brand-950 via-brand-900 to-slate-950 px-4 py-12 font-sans text-slate-900">
			<div class="w-full max-w-sm">
				<div class="mb-8 flex flex-col items-center text-center">
					@LogoMark("h-16 w-16 drop-shadow-lg")
					<h1 class="mt-4 text-2xl font-semibold tracking-tight text-white">Hesap Kitap</h1>
					<p class="mt-1 text-sm text-brand-200">Fatura ve cari takip sistemi</p>
				</div>
				<form method="post" action="/login" class="space-y-4 rounded-2xl bg-white p-7 shadow-2xl shadow-black/30">
					<h2 class="text-lg font-semibold">Giriş yap</h2>
					if errMsg != "" {
						<div role="alert" class="rounded-xl bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-inset ring-rose-200">{ errMsg }</div>
					}
					<div>
						<label for="email" class="block text-sm font-medium text-slate-700">E-posta</label>
						<input id="email" name="email" type="email" value={ email } required autocomplete="username" autofocus class="input !text-base"/>
					</div>
					<div>
						<label for="password" class="block text-sm font-medium text-slate-700">Şifre</label>
						<input id="password" name="password" type="password" required autocomplete="current-password" class="input !text-base"/>
					</div>
					<button type="submit" class="btn btn-primary w-full !py-2.5">Giriş yap</button>
				</form>
			</div>
		</body>
	</html>
}
