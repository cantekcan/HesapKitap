package views

import (
	"fmt"

	"hesapkitap/internal/invoice"
	"hesapkitap/internal/money"
	"hesapkitap/internal/product"
)

// InvoiceView is the read-only page of an invoice that has left the draft state.
type InvoiceView struct {
	Draft   invoice.Draft
	Totals  invoice.Totals
	CanCancel bool // kullanıcının iptal yetkisi var mı
	Message string // kullanıcıya gösterilecek hata veya bilgi
	Flash   string
}

func statusBadgeClass(s invoice.Status) string {
	switch s {
	case invoice.StatusIssued:
		return "badge badge-green"
	case invoice.StatusErrored:
		return "badge badge-red"
	case invoice.StatusSending:
		return "badge badge-amber"
	case invoice.StatusDraft:
		return "badge badge-slate"
	}
	return "badge badge-slate"
}

func providerStatusText(d invoice.Draft) string {
	if d.ProviderStatus == nil {
		return "—"
	}
	return d.ProviderStatus.String()
}

templ InvoiceViewPage(p PageData, v InvoiceView) {
	@Layout(p) {
		@InvoiceStatusBox(v)
		<div class="mt-5 card p-5">
			<h2 class="mb-3 text-sm font-semibold text-slate-900">Kalemler</h2>
			<div class="overflow-x-auto">
				<table class="data-table">
					<thead class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
						<tr>
							<th class="pb-2 pr-3">Açıklama</th>
							<th class="pb-2 pr-3 text-right">Miktar</th>
							<th class="pb-2 pr-3 text-right">Birim fiyat</th>
							<th class="pb-2 pr-3 text-right">İndirim</th>
							<th class="pb-2 pr-3 text-right">KDV</th>
							<th class="pb-2 text-right">Tutar (KDV dahil)</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for i, l := range v.Draft.Lines {
							<tr>
								<td class="py-2 pr-3">{ l.ItemName }</td>
								<td class="py-2 pr-3 text-right tabular-nums">{ l.Quantity.String() } { product.UnitLabel(l.Unit) }</td>
								<td class="py-2 pr-3 text-right tabular-nums">{ money.FormatTL(l.UnitPrice) }</td>
								<td class="py-2 pr-3 text-right tabular-nums">{ money.FormatTL(l.Discount) }</td>
								<td class="py-2 pr-3 text-right tabular-nums">%{ fmt.Sprint(l.TaxPercent) }</td>
								<td class="py-2 text-right tabular-nums">{ money.FormatTL(v.Totals.Lines[i].Total) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="mt-4">
				@InvoiceTotals(&v.Totals, "")
			</div>
		</div>
	}
}

// InvoiceStatusBox shows status, numbers and actions. While the invoice is being sent it polls itself every 4 seconds.
templ InvoiceStatusBox(v InvoiceView) {
	<div
		id="status-box"
		class="card p-5"
		if v.Draft.IsPolling() {
			hx-get={ "/invoices/" + v.Draft.ID.String() + "/status" }
			hx-trigger="every 4s"
			hx-swap="outerHTML"
		}
	>
		if v.Flash != "" {
			<div class="mb-3 rounded-xl bg-emerald-50 px-3 py-2 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-200">{ v.Flash }</div>
		}
		if v.Message != "" {
			<div class="mb-3 rounded-xl bg-rose-50 px-3 py-2 text-sm text-rose-800 ring-1 ring-inset ring-rose-200">{ v.Message }</div>
		}
		<div class="flex flex-wrap items-center gap-3">
			<span class={ statusBadgeClass(v.Draft.Status) }>{ v.Draft.Status.Label() }</span>
			<span class="text-sm text-slate-600">{ v.Draft.Kind.Label() }</span>
			if v.Draft.Status == invoice.StatusSending {
				<span class="text-sm text-amber-700">Trendyol'a gönderiliyor… Bu sayfa kendiliğinden güncellenir.</span>
			}
		</div>
		<dl class="mt-4 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
			<div><dt class="text-slate-500">Müşteri</dt><dd class="font-medium">{ v.Draft.CustomerName }</dd></div>
			<div><dt class="text-slate-500">Ödenecek tutar</dt><dd class="font-medium tabular-nums">{ money.FormatTL(v.Draft.Payable) }</dd></div>
			<div><dt class="text-slate-500">Fatura tarihi</dt><dd>{ dateText(v.Draft.IssueDate) }</dd></div>
			<div><dt class="text-slate-500">Vade</dt><dd>{ dateTextPtr(v.Draft.DueDate) }</dd></div>
			<div><dt class="text-slate-500">Fatura no</dt><dd class="font-mono">{ v.Draft.Number }</dd></div>
			<div><dt class="text-slate-500">Trendyol durumu</dt><dd>{ providerStatusText(v.Draft) }</dd></div>
			<div class="sm:col-span-2"><dt class="text-slate-500">ETTN</dt><dd class="break-all font-mono text-xs">{ v.Draft.ETTN.String() }</dd></div>
		</dl>
		if v.Draft.LastError != "" {
			<p class="mt-3 rounded-xl bg-amber-50 px-3 py-2 text-xs text-amber-900 ring-1 ring-inset ring-amber-200">Son hata: { v.Draft.LastError }</p>
		}
		if v.Draft.Status == invoice.StatusIssued || v.Draft.Status == invoice.StatusAnnulled {
			<div class="mt-4 flex flex-wrap items-center gap-3">
				<a href={ templ.SafeURL("/invoices/" + v.Draft.ID.String() + "/pdf") } target="_blank" rel="noopener" class={ btnPrimary }>PDF görüntüle</a>
				<button type="button" hx-post={ "/invoices/" + v.Draft.ID.String() + "/share" } hx-target="#share-link" hx-swap="innerHTML" class={ btnSecondary }>Paylaşım bağlantısı</button>
				if v.CanCancel && v.Draft.Status == invoice.StatusIssued && v.Draft.Kind == invoice.KindEArchive {
					<form method="post" action={ templ.SafeURL("/invoices/" + v.Draft.ID.String() + "/cancel") } @submit="if (!confirm('Bu e-Arşiv fatura iptal edilsin mi? İptal geri alınamaz.')) $event.preventDefault()">
						<button type="submit" class="btn btn-danger">Faturayı iptal et</button>
					</form>
				}
			</div>
			<div id="share-link" class="mt-3 text-sm"></div>
		}
	</div>
}

// ShareLink is the answer of the "Paylaşım bağlantısı" button.
templ ShareLink(link, errMsg string) {
	if errMsg != "" {
		<span class="text-red-700">{ errMsg }</span>
	} else {
		<div x-data={ "{ l: " + jsonString(link) + ", copied: false }" } class="flex flex-wrap items-center gap-2">
			<input readonly value={ link } class="w-full max-w-xl rounded-lg border border-slate-300 px-2 py-1.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 text-xs" @focus="$el.select()"/>
			<button type="button" class={ btnSecondary } @click="navigator.clipboard.writeText(l); copied = true">Kopyala</button>
			<a href={ templ.SafeURL("https://wa.me/?text=" + templURLEscape(link)) } target="_blank" rel="noopener" class={ btnSecondary }>WhatsApp</a>
			<a href={ templ.SafeURL("mailto:?subject=" + templURLEscape("Faturanız") + "&body=" + templURLEscape("Faturanıza şu bağlantıdan ulaşabilirsiniz: "+link)) } class={ btnSecondary }>E-posta</a>
			<span x-show="copied" x-cloak class="text-emerald-700">Kopyalandı</span>
		</div>
	}
}
